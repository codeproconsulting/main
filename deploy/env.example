# --- PRODUCTION CONFIGURATION ---
# The public URL of your website (used for SEO and canonical links)
VITE_APP_URL=https://proconsulting.uk

# --- GHOST CMS (BLOG) CONFIGURATION ---
# Your Ghost CMS instance URL (where you edit posts)
VITE_GHOST_API_URL=https://your-blog-instance.ghost.io
# Also used by immigration section (ensure consistency)
VITE_GHOST_URL=https://your-blog-instance.ghost.io
# Ghost Content API key (from Settings -> Integrations -> Custom Integration)
VITE_GHOST_CONTENT_API_KEY=your_content_api_key_here

# --- CONTACT FORM CONFIGURATION ---
# The Google Apps Script "Web App" URL for handling form submissions
VITE_GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec
