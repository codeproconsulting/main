# --- PRODUCTION CONFIGURATION ---
# The public URL of your website (used for SEO and canonical links)
VITE_APP_URL=https://proconsulting.uk

# --- GHOST CMS (BLOG) CONFIGURATION ---
# Your Ghost CMS instance URL (where you edit posts)
VITE_GHOST_API_URL=https://your-blog-instance.ghost.io
# Also used by immigration section (ensure consistency)
VITE_GHOST_URL=https://your-blog-instance.ghost.io
# Ghost Content API key (from Settings -> Integrations -> Custom Integration)
VITE_GHOST_CONTENT_API_KEY=your_content_api_key_here

# --- CONTACT FORM CONFIGURATION ---
# The Google Apps Script "Web App" URL for handling form submissions
VITE_GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec

# --- STAFF WORKSPACE / APPWRITE (server-only; never prefix secrets with VITE_) ---
DASHBOARD_URL=https://crm.proconsulting.uk
APPWRITE_ENDPOINT=https://appwrite.proconsulting.uk/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_DATABASE_ID=proconsulting
APPWRITE_API_KEY=your_scoped_server_key
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_random_characters
# PM2 sets APP_SURFACE and PORT independently for the website and CRM processes.
# Leave website blogs on Ghost until import, routing, and asset validation pass.

# Private buckets; browser clients never receive the server key.
APPWRITE_DOCUMENT_BUCKET=crm-documents
APPWRITE_MEDIA_BUCKET=crm-media
BLOG_PROVIDER=ghost
# Optional SSR content origin. Default: current process's loopback PORT.
# PUBLIC_CONTENT_ORIGIN=http://127.0.0.1:3000
# Worker opt-ins are passed to the PM2 invocation, not enabled here.
# See docs/SCHEDULED-PUBLISHING.md and the feature ledger before enabling them.
